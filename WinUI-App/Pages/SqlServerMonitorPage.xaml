<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinUI_App.Pages.SqlServerMonitorPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:WinUI_App.Pages">
    <ScrollView Padding="36,24,36,36">
        <StackPanel MaxWidth="1280" Spacing="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SQL Server Performance Center" Style="{StaticResource TitleTextBlockStyle}"/>
                    <TextBlock x:Name="ServerIdentityText" Text="Connect to a SQL Server instance to start monitoring." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <ToggleSwitch x:Name="AutoRefresh" Header="Live"/>
                    <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click" Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
            </Grid>
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True"/>
            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <ComboBox x:Name="SavedDatabaseBox" Header="Saved database" ItemsSource="{x:Bind SavedConnections}" DisplayMemberPath="Name" SelectionChanged="SavedDatabaseBox_SelectionChanged"/>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ServerBox" Header="SQL Server" PlaceholderText="server\instance or server,port"/>
                    <TextBox x:Name="DatabaseBox" Grid.Column="1" Header="Database" PlaceholderText="Database name"/>
                    <Button Grid.Column="2" Content="Connect &amp; monitor" Click="ConnectButton_Click" VerticalAlignment="Bottom"/>
                </Grid>
                </StackPanel>
            </Border>
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Health score" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Name="HealthText" Text="—" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HealthDetail" Text="Waiting for a connection" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="SQL CPU" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Name="CpuText" Text="—" FontSize="30" FontWeight="SemiBold"/>
                        <ProgressBar x:Name="CpuBar" Minimum="0" Maximum="100" Height="6"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Server memory" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Name="MemoryText" Text="—" FontSize="30" FontWeight="SemiBold"/>
                        <ProgressBar x:Name="MemoryBar" Minimum="0" Maximum="100" Height="6"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Database size" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Name="SizeText" Text="—" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RefreshTimeText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Performance findings" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <ListView ItemsSource="{x:Bind Findings}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:MonitorFinding">
                                    <StackPanel Padding="4">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Operations" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <ListView ItemsSource="{x:Bind Operations}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:MonitorFinding">
                                    <StackPanel Padding="4">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollView>
</Page>
